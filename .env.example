# Токен от @BotFather (заведи нового бота, не тот же, что для PubChem)
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-token-here
# Файл базы
DB_PATH=market.db
# Монеты, котировки к USDT
ASSETS=BTC,ETH,SOL
# Как часто опрашивать биржи, в секундах
COLLECT_SECONDS=30
# Отклонение от медианы по биржам, после которого котировка считается аномальной, в %
OUTLIER_PCT=1.0
# Минимальная пауза между алертами по одной монете, в минутах
ALERT_COOLDOWN_MIN=10
# Сколько дней хранить снапшоты
RETENTION_DAYS=7
